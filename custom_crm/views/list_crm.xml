    <!-- Add your field to existing quick create -->
    <record id="quick_create_opportunity_form_custom" model="ir.ui.view">
        <field name="name">Quick Create Opportunity Custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="crm_code" placeholder="Code"/>
            </xpath>
        </field>
    </record>

    <!-- Enable quick create (no custom view needed) -->
    <record id="crm_case_kanban_view_leads_simple" model="ir.ui.view">
        <field name="name">CRM Leads Kanban Simple</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="quick_create">true</attribute>
            </xpath>
        </field>
    </record>
