<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add CRM Code to form view -->
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="crm_code" placeholder="Auto-generated if empty"/>
            </xpath>
        </field>
    </record>

    <!-- Add CRM Code to list view -->
     <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_name']" position="after">
                <field name="crm_code" placeholder="Auto-generated if empty"/>
            </xpath>
        </field>
    </record>

    <!-- Search view inheritance -->
    <record id="crm_lead_view_search_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="crm_code"/>
            </xpath>
        </field>
    </record>

